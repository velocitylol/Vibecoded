-- ============ DUMPER ============
local running = false
local function hasFn(n) return type(rawget(getfenv(), n)) == "function" end

local function collectAll()
    local remoteLines = {}
    local adminLines = {}
    local total = 0
    local adminHits = 0
    local remoteCount = 0

    -- gather services we can reach
    local svcs = {}
    for _, name in ipairs(SERVICES) do
        local ok, s = pcall(game.GetService, game, name)
        if ok and s then svcs[#svcs+1] = s end
    end

    -- count total descendants first for the progress bar
    local totalCount = 0
    for _, s in ipairs(svcs) do
        local ok, desc = pcall(function() return s:GetDescendants() end)
        if ok and desc then totalCount = totalCount + #desc end
    end
    totalCount = math.max(totalCount, 1)

    local processed = 0
    local function tick()
        processed = processed + 1
        if processed % 100 == 0 then
            local p = math.min(1, processed / totalCount)
            barFill.Size = UDim2.new(p, 0, 1, 0)
            pct.Text = math.floor(p * 100) .. "%"
            status.Text = "scanning"
            task.wait()
        end
    end

    for _, s in ipairs(svcs) do
        local ok, desc = pcall(function() return s:GetDescendants() end)
        if not ok or not desc then goto continue end
        for _, d in ipairs(desc) do
            tick()
            total = total + 1

            -- log remotes
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction")
                or d:IsA("UnreliableRemoteEvent") then
                remoteCount = remoteCount + 1
                remoteLines[#remoteLines+1] = d:GetFullName() .. "  [" .. d.ClassName .. "]"
            end

            -- keyword check
            local name = d.Name:lower()
            local parentChain = d:GetFullName():lower()
            local hit = nil
            for _, k in ipairs(KEYWORDS) do
                if name:find(k, 1, true) then
                    hit = k
                    break
                end
            end
            if hit then
                adminHits = adminHits + 1
                local kind = d.ClassName
                local extra = ""
                if d:IsA("RemoteEvent") or d:IsA("RemoteFunction")
                    or d:IsA("UnreliableRemoteEvent") then
                    extra = "  REMOTE"
                end
                adminLines[#adminLines+1] = "[" .. hit .. "] " .. d:GetFullName()
                    .. "  (" .. kind .. ")" .. extra
            end

            if processed % 250 == 0 then
                filesVal.Text = tostring(total)
                adminVal.Text = tostring(adminHits)
                remoteVal.Text = tostring(remoteCount)
                current.Text = d:GetFullName():sub(1, 60)
            end
        end
        ::continue::
    end

    return remoteLines, adminLines, total, adminHits, remoteCount
end

local function writeOut(folder, remoteLines, adminLines, total, adminHits, remoteCount)
    if not hasFn("makefolder") or not hasFn("writefile") then
        status.Text = "no file access"
        return false
    end
    pcall(makefolder, folder)

    local rm = table.concat(remoteLines, "\n")
    local am = table.concat(adminLines, "\n")

    local summary = table.concat({
        "Game: " .. tostring(game.Name),
        "PlaceId: " .. tostring(game.PlaceId),
        "JobId: " .. tostring(game.JobId),
        "Folder: " .. folder,
        "Scanned: " .. tostring(total),
        "Remotes: " .. tostring(remoteCount),
        "Admin: " .. tostring(adminHits),
        "Time: " .. os.date("%Y-%m-%d %H:%M:%S"),
    }, "\n")

    pcall(writefile, folder .. "/remotes_manifest.txt", rm)
    pcall(writefile, folder .. "/admin_findings.txt", am)
    pcall(writefile, folder .. "/_summary.txt", summary)
    return true
end

startB.MouseButton1Click:Connect(function()
    if running then return end
    running = true
    startB.Text = "..."
    startB.BackgroundColor3 = Color3.fromRGB(120, 100, 30)

    barFill.Size = UDim2.new(0, 0, 1, 0)
    pct.Text = "0%"
    status.Text = "scanning"

    local folder = nextFolderName()
    task.spawn(function()
        local ok, err = pcall(function()
            local remoteLines, adminLines, total, adminHits, remoteCount = collectAll()
            status.Text = "writing"
            barFill.Size = UDim2.new(1, 0, 1, 0)
            pct.Text = "100%"
            filesVal.Text = tostring(total)
            adminVal.Text = tostring(adminHits)
            remoteVal.Text = tostring(remoteCount)

            local wrote = writeOut(folder, remoteLines, adminLines, total, adminHits, remoteCount)
            if wrote then
                status.Text = "done -> " .. folder
                status.TextColor3 = Color3.fromRGB(140, 255, 140)
            else
                status.Text = "scan done, no writefile"
                status.TextColor3 = Color3.fromRGB(255, 200, 120)
            end
        end)
        if not ok then
            status.Text = "err: " .. tostring(err):sub(1, 40)
            status.TextColor3 = Color3.fromRGB(255, 120, 120)
        end
        running = false
        startB.Text = "start"
        startB.BackgroundColor3 = Color3.fromRGB(60, 140, 60)
    end)
end)

