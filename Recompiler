local kws = {"admin","owner","staff","moderator","mod ","dev","developer","command","cmd","execute","ban","kick","mute","give","grant","spawn","broadcast","announce","debug","bypass","backdoor","cheat","test"}

local function collect()
    local rem, adm, tot, hits, rc = {}, {}, 0, 0, 0
    local svcs = {}
    for _, n in ipairs({"ReplicatedStorage","ReplicatedFirst","StarterGui","StarterPack","StarterPlayer","Workspace","ServerScriptService","ServerStorage","Players","CoreGui","Chat","ChatService","Teams"}) do
        local ok, s = pcall(game.GetService, game, n)
        if ok and s then svcs[#svcs+1] = s end
    end
    for _, s in ipairs(svcs) do
        local ok, d = pcall(function() return s:GetDescendants() end)
        if ok and d then
            for _, x in ipairs(d) do
                tot = tot + 1
                if x:IsA("RemoteEvent") or x:IsA("RemoteFunction") or x:IsA("UnreliableRemoteEvent") then
                    rc = rc + 1
                    rem[#rem+1] = x:GetFullName() .. "  [" .. x.ClassName .. "]"
                end
                local nm = x.Name:lower()
                for _, k in ipairs(kws) do
                    if nm:find(k, 1, true) then
                        hits = hits + 1
                        adm[#adm+1] = "[" .. k .. "] " .. x:GetFullName() .. "  (" .. x.ClassName .. ")"
                        break
                    end
                end
            end
        end
    end
    return rem, adm, tot, hits, rc
end

local function nextFolder()
    local n = 1
    if type(listfiles) == "function" then
        local ok, f = pcall(listfiles)
        if ok and f then
            for _, x in ipairs(f) do
                local num = x:match("^Ugc_(%d+)$")
                if num then local v = tonumber(num) if v >= n then n = v + 1 end end
            end
        end
    end
    return "Ugc_" .. string.format("%03d", n)
end

local rem, adm, tot, hits, rc = collect()
local folder = nextFolder()

if type(makefolder) == "function" then pcall(makefolder, folder) end
if type(writefile) == "function" then
    pcall(writefile, folder .. "/remotes_manifest.txt", table.concat(rem, "\n"))
    pcall(writefile, folder .. "/admin_findings.txt", table.concat(adm, "\n"))
    pcall(writefile, folder .. "/_summary.txt", table.concat({
        "Game: " .. game.Name,
        "PlaceId: " .. game.PlaceId,
        "JobId: " .. game.JobId,
        "Folder: " .. folder,
        "Scanned: " .. tot,
        "Remotes: " .. rc,
        "Admin: " .. hits,
        "Time: " .. os.date("%Y-%m-%d %H:%M:%S"),
    }, "\n"))
end

print("=== DUMP DONE ===")
print("folder: " .. folder)
print("scanned: " .. tot .. "  remotes: " .. rc .. "  admin: " .. hits)
print("--- admin hits ---")
for i = 1, math.min(#adm, 40) do print(adm[i]) end
if #adm == 0 then print("(none)") end
print("--- first 25 remotes ---")
for i = 1, math.min(#rem, 25) do print(rem[i]) end
