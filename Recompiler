local dragging, dragStart, startPos
fr.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = i.Position
        startPos = fr.Position
    end
end)
fr.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
        local v = i.Position - dragStart
        fr.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + v.X,
                                startPos.Y.Scale, startPos.Y.Offset + v.Y)
    end
end)
fr.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- ==================== helpers ====================
local function nextFolderName()
    local n = 1
    if type(listfiles) == "function" then
        local ok, files = pcall(listfiles)
        if ok and files then
            for _, f in ipairs(files) do
                local num = tostring(f):match("^Ugc_(%d+)$")
                if num then
                    local v = tonumber(num)
                    if v and v >= n then n = v + 1 end
                end
            end
        end
    end
    return "Ugc_" .. string.format("%03d", n)
end

-- ==================== scan ====================
local running = false
startB.MouseButton1Click:Connect(function()
    if running then return end
    running = true
    startB.Text = "..."
    startB.BackgroundColor3 = Color3.fromRGB(120, 100, 30)

    task.spawn(function()
        local adminLines, remoteLines, backLines = {}, {}, {}
        local folderLines = {}
        local total, adminCount, remoteCount, backCount = 0, 0, 0, 0

        local svcs = {}
        for _, name in ipairs(SCAN_SERVICES) do
            local ok, s = pcall(game.GetService, game, name)
            if ok and s then svcs[#svcs+1] = s end
        end

        local grandTotal = 0
        for _, s in ipairs(svcs) do
            local ok, d = pcall(function() return s:GetDescendants() end)
            if ok and d then grandTotal = grandTotal + #d end
        end
        if grandTotal < 1 then grandTotal = 1 end

        status.Text = "scanning"
        local counter = 0
        for _, s in ipairs(svcs) do
            local ok, list = pcall(function() return s:GetDescendants() end)
            if ok and list then
                for _, x in ipairs(list) do
                    counter = counter + 1
                    total = total + 1

                    local cls = x.ClassName
                    local isScript = SCRIPT_CLASSES[cls] == true
                    local isRemote = cls == "RemoteEvent" or cls == "RemoteFunction"
                        or cls == "UnreliableRemoteEvent"

                    -- remotes: always log
                    if isRemote then
                        remoteCount = remoteCount + 1
                        remoteLines[#remoteLines+1] = x:GetFullName() .. "  [" .. cls .. "]"
                    end

                    -- name match on scripts / folders / remotes only
                    if isScript or x:IsA("Folder") then
                        local kw = adminMatch(x.Name)
                        if kw then
                            adminCount = adminCount + 1
                            local tag = isRemote and "REMOTE" or cls
                            adminLines[#adminLines+1] = "[" .. kw .. "] "
                                .. x:GetFullName() .. "  (" .. tag .. ")"
                        end
                    end

                    -- explicit admin folder names
                    if x:IsA("Folder") then
                        for _, fn in ipairs(ADMIN_FOLDERS) do
                            if x.Name:lower() == fn then
                                folderLines[#folderLines+1] = x:GetFullName()
                                    .. "  (contains "
                                    .. tostring(#x:GetChildren()) .. " children)"
                                break
                            end
                        end
                    end

                    -- backdoor indicators in readable sources
                    if isScript and type(getscriptbytecode) == "function" then
                        local ok2, src = pcall(function() return x.Source end)
                        if ok2 and src and #src > 0 then
                            for _, k in ipairs(BACKDOOR_KEYS) do
                                if src:find(k, 1, true) then
                                    backCount = backCount + 1
                                    backLines[#backLines+1] = "[" .. k .. "] "
                                        .. x:GetFullName() .. "  (" .. cls .. ")"
                                    break
                                end
                            end
                        end
                    end

                    if counter % 200 == 0 then
                        local p = math.min(1, counter / grandTotal)
                        barFill.Size = UDim2.new(p, 0, 1, 0)
                        pct.Text = math.floor(p * 100) .. "%"
                        filesVal.Text = tostring(total)
                        adminVal.Text = tostring(adminCount)
                        remoteVal.Text = tostring(remoteCount)
                        current.Text = x:GetFullName():sub(1, 60)
                        task.wait()
                    end
                end
            end
        end

        filesVal.Text = tostring(total)
        adminVal.Text = tostring(adminCount)
        remoteVal.Text = tostring(remoteCount)
        barFill.Size = UDim2.new(1, 0, 1, 0)
        pct.Text = "100%"
        status.Text = "writing"
        current.Text = ""

        local folder = nextFolderName()
        if type(makefolder) == "function" then pcall(makefolder, folder) end

        if type(writefile) == "function" then
            local adminOut = "# ADMIN CANDIDATES\n"
                .. table.concat(adminLines, "\n")
                .. "\n\n# ADMIN FOLDERS\n"
                .. table.concat(folderLines, "\n")
                .. "\n\n# BACKDOOR INDICATORS\n"
                .. table.concat(backLines, "\n")

            pcall(writefile, folder .. "/admin_findings.txt", adminOut)
            pcall(writefile, folder .. "/remotes_manifest.txt",
                table.concat(remoteLines, "\n"))
            pcall(writefile, folder .. "/_summary.txt", table.concat({
                "Game: " .. game.Name,
                "PlaceId: " .. game.PlaceId,
                "JobId: " .. game.JobId,
                "Folder: " .. folder,
                "Scanned: " .. total,
                "Admin: " .. adminCount,
                "Remotes: " .. remoteCount,
                "Backdoor: " .. backCount,
                "Time: " .. os.date("%Y-%m-%d %H:%M:%S"),
            }, "\n"))
            status.Text = "done -> " .. folder
            status.TextColor3 = Color3.fromRGB(140, 255, 140)
        else
            status.Text = "no writefile"
            status.TextColor3 = Color3.fromRGB(255, 120, 120)
        end

        running = false
        startB.Text = "start"
        startB.BackgroundColor3 = Color3.fromRGB(60, 140, 60)
    end)
end)

