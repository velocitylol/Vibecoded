-- ==================== rules ====================
local ADMIN_PHRASES = {
    "admincommand","executecommand","runcommand","globalmessage",
    "givecash","givecoins","givemoney","giveitem","givecrate","giveboost",
    "grantadmin","grantitem","setmoney","setcash","setcoins","addmoney",
    "addcash","addcoins","killplayer","banplayer","kickplayer","healplayer",
    "adminremote","adminpanel","adminmenu","staffpanel","devpanel",
    "modpanel","modmenu","ownerpanel","adminaction","admincmd",
}
local ADMIN_WORDS = {
    "admin","ban","kick","mute","unmute","jail","unjail","freeze","unfreeze",
    "grant","revive","heal","punish","broadcast","announce",
    "command","execute","console","staff","owner","moderator","cmd",
}
local ADMIN_FOLDERS = {
    "admin","adminremotes","devremotes","debugremotes","modremotes",
    "staffremotes","ownerremotes","adminmodules","admincommands","admins",
}
local SCRIPT_CLASSES = {
    RemoteEvent = true, RemoteFunction = true, UnreliableRemoteEvent = true,
    ModuleScript = true, Script = true, LocalScript = true, CoreScript = true,
    BindableEvent = true, BindableFunction = true,
}
local SCAN_SERVICES = {
    "ReplicatedStorage","ReplicatedFirst","StarterGui","StarterPack",
    "StarterPlayer","ServerScriptService","ServerStorage",
}
local BACKDOOR_KEYS = {
    "loadstring","getfenv","setfenv","HttpGet","GetAsync","PostAsync",
    "RequestAsync","http_request","webhook","pastebin","hastebin",
    "pastes.io","raw.githubusercontent","discord.com/api","getscriptbytecode",
}

local function hasWord(s, w)
    return s:lower():match("%f[%a]" .. w .. "%f[%A]") ~= nil
end

local function adminMatch(name)
    local low = name:lower()
    for _, p in ipairs(ADMIN_PHRASES) do
        if low:find(p, 1, true) then return p end
    end
    for _, w in ipairs(ADMIN_WORDS) do
        if hasWord(low, w) then return w end
    end
    return nil
end

