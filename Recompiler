-- drag
local dragging, dragStart, startPos
fr.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = i.Position
        startPos = fr.Position
    end
end)
fr.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
        local v = i.Position - dragStart
        fr.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + v.X,
                                startPos.Y.Scale, startPos.Y.Offset + v.Y)
    end
end)
fr.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- =================== DUMPER ===================
local function nextFolderName()
    local n = 1
    if type(listfiles) == "function" then
        local ok, files = pcall(listfiles)
        if ok and files then
            for _, f in ipairs(files) do
                local num = tostring(f):match("^Ugc_(%d+)$")
                if num then
                    local v = tonumber(num)
                    if v and v >= n then n = v + 1 end
                end
            end
        end
    end
    return "Ugc_" .. string.format("%03d", n)
end

local running = false

startB.MouseButton1Click:Connect(function()
    if running then return end
    running = true
    startB.Text = "..."
    startB.BackgroundColor3 = Color3.fromRGB(120, 100, 30)

    task.spawn(function()
        local rem, adm = {}, {}
        local tot, hits, rc = 0, 0, 0

        -- gather services
        local svcs = {}
        for _, name in ipairs(svcNames) do
            local ok, s = pcall(game.GetService, game, name)
            if ok and s then svcs[#svcs+1] = s end
        end

        -- count for progress
        local grandTotal = 0
        for _, s in ipairs(svcs) do
            local ok, d = pcall(function() return s:GetDescendants() end)
            if ok and d then grandTotal = grandTotal + #d end
        end
        if grandTotal < 1 then grandTotal = 1 end

        status.Text = "scanning"

        -- walk
        local counter = 0
        for _, s in ipairs(svcs) do
            local ok, list = pcall(function() return s:GetDescendants() end)
            if ok and list then
                for _, x in ipairs(list) do
                    counter = counter + 1
                    tot = tot + 1

                    if x:IsA("RemoteEvent") or x:IsA("RemoteFunction") then
                        rc = rc + 1
                        rem[#rem+1] = x:GetFullName() .. "  [" .. x.ClassName .. "]"
                    end

                    local nm = x.Name:lower()
                    for _, k in ipairs(kws) do
                        if nm:find(k, 1, true) then
                            hits = hits + 1
                            adm[#adm+1] = "[" .. k .. "] " .. x:GetFullName()
                                .. "  (" .. x.ClassName .. ")"
                            break
                        end
                    end

                    if counter % 200 == 0 then
                        local p = math.min(1, counter / grandTotal)
                        barFill.Size = UDim2.new(p, 0, 1, 0)
                        pct.Text = math.floor(p * 100) .. "%"
                        filesVal.Text = tostring(tot)
                        adminVal.Text = tostring(hits)
                        remoteVal.Text = tostring(rc)
                        current.Text = x:GetFullName():sub(1, 60)
                        task.wait()
                    end
                end
            end
        end

        filesVal.Text = tostring(tot)
        adminVal.Text = tostring(hits)
        remoteVal.Text = tostring(rc)
        barFill.Size = UDim2.new(1, 0, 1, 0)
        pct.Text = "100%"
        status.Text = "writing"

        -- write files
        local folder = nextFolderName()

        if type(makefolder) == "function" then
            pcall(makefolder, folder)
        end

        if type(writefile) == "function" then
            pcall(writefile, folder .. "/remotes_manifest.txt", table.concat(rem, "\n"))
            pcall(writefile, folder .. "/admin_findings.txt",  table.concat(adm, "\n"))
            pcall(writefile, folder .. "/_summary.txt", table.concat({
                "Game: "    .. game.Name,
                "PlaceId: " .. game.PlaceId,
                "JobId: "   .. game.JobId,
                "Folder: "  .. folder,
                "Scanned: " .. tot,
                "Remotes: " .. rc,
                "Admin: "   .. hits,
                "Time: "    .. os.date("%Y-%m-%d %H:%M:%S"),
            }, "\n"))
            status.Text = "done -> " .. folder
            status.TextColor3 = Color3.fromRGB(140, 255, 140)
        else
            status.Text = "no writefile"
            status.TextColor3 = Color3.fromRGB(255, 120, 120)
        end

        running = false
        startB.Text = "start"
        startB.BackgroundColor3 = Color3.fromRGB(60, 140, 60)
    end)
end)
